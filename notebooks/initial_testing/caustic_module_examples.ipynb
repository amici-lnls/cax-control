    "sys.path.append(os.path.expanduser(\"~/repos/cax-control\"))\n",
    "\n",
    "from caustic import ana_from_image, fit_beam_image, image_caustic, fit_caustic_hyperbola\n",
    "from shadowpy.si_beamlines import CAXSim\n",
    "from shadowpy.utils import save_image, image_from_beam\n",
    "from image_statistics import Histogram2DAnalyzer\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "# Example only: replace these with your real beam and element objects.\n",
    "# beam = cax.dvf_B1.beam.duplicate()\n",
    "# frame = cax.dvf_B1.frame"
