    "# Step 3: compute moment estimates and then run the fit explicitly.\n",
    "# This is the important part: the beam is not fitted automatically when the raw\n",
    "# image is saved. The Gaussian fit must be run in the analyzer.\n",
    "moments = ana.compute_momenta()\n",
    "fit = ana.fit(hprm=moments)\n",
    "ana.print_stats(fit)\n",
    "# Example placeholder.\n",
    "# fit = None"
   ]
